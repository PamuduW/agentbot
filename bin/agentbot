#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${AGENTBOT_HOME:-}" && -d "$AGENTBOT_HOME" ]]; then
	AGENTBOT_HOME="$(cd "$AGENTBOT_HOME" && pwd)"
else
	# Resolve the executable first: install.sh exposes Agentbot through
	# ~/bin/agentbot, and BASH_SOURCE would otherwise resolve that symlink's
	# directory instead of this repository.
	AGENTBOT_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
	AGENTBOT_HOME="$(cd "$(dirname "$AGENTBOT_SCRIPT")/.." && pwd)"
fi
export AGENTBOT_HOME

# shellcheck source=/dev/null
source "$AGENTBOT_HOME/scripts/lib/shared/tui/tty.sh"

agentbot_die() {
	printf '  [err] %s\n' "$*" >&2
	return 1
}

agentbot_has_tty() {
	case "${AGENTBOT_TTY:-}" in 1 | true) return 0 ;; 0 | false) return 1 ;; esac
	tty_available
}

agentbot_load_menu() {
	if [[ "${AGENTBOT_MENU_LOADED:-0}" != 1 ]]; then
		# shellcheck source=/dev/null
		source "$AGENTBOT_HOME/scripts/menu.sh"
		AGENTBOT_MENU_LOADED=1
	fi
}

agentbot_run_menu() {
	agentbot_load_menu
	agentbot_menu_loop
}

agentbot_run_token() {
	agentbot_load_menu
	agentbot_token_config_menu
}

# capability: install-menu
#
# The component selector, the execution plan, and the install run -- the three
# screens the main menu's Install entry drives -- reachable without the main
# menu. A caller that has already decided the operator is installing Agentbot
# -- the Dotfiles bootstrap does -- needs that sequence, not a menu offering Check
# Status, Prune Skills and Quit alongside it.
#
# AGENTBOT_TUI is what the menu loop exports, and the selector reads it to pick
# its output seam; setting it here is what makes the standalone entry draw the
# same screens. No trailing pause: the caller continues straight into its next
# step, and a keypress between them buys nothing.
AGENTBOT_INSTALL_MENU_CANCELLED_RC=4
agentbot_run_install_menu() {
	local rc=0
	agentbot_load_menu
	export AGENTBOT_TUI=1
	tui_init_colors
	AGENTBOT_INSTALL_SELECTION_CANCELLED=false
	tui_clear
	agentbot_menu_components || rc=$?
	# Quitting the selector is a legitimate answer, but it is not an install.
	# Reported distinctly so a caller does not record a phase that never ran.
	if ((rc == 0)) && [[ "${AGENTBOT_INSTALL_SELECTION_CANCELLED:-false}" == true ]]; then
		return "$AGENTBOT_INSTALL_MENU_CANCELLED_RC"
	fi
	return "$rc"
}
agentbot_run_backend() { "$AGENTBOT_HOME/install.sh" "$@"; }

agentbot_usage() {
	(cd "$AGENTBOT_HOME" && python3 -m src.cli --root "$AGENTBOT_HOME" help "$@")
}

agentbot_main() {
	local command="${1:-}"
	[[ $# -eq 0 ]] || shift
	case "$command" in
	'')
		if agentbot_has_tty; then
			agentbot_run_menu
		else agentbot_die 'No usable controlling TTY. Use agentbot help or an explicit command such as agentbot install.'; fi
		;;
	install)
		if [[ "${1:-}" == --menu ]]; then
			shift
			agentbot_has_tty ||
				agentbot_die 'agentbot install --menu needs a controlling TTY. Use agentbot install.'
			agentbot_run_install_menu "$@"
		else
			agentbot_run_backend install "$@"
		fi
		;;
	status | full | doctor) agentbot_run_backend "$command" "$@" ;;
	boot) agentbot_run_backend "$command" "$@" ;;
	workspace | workspaces | resync) agentbot_run_backend "$command" "$@" ;;
	graphify | boost) agentbot_run_backend "$command" "$@" ;;
	cli-config | cursor | vscode) agentbot_run_backend "$command" "$@" ;;
	token) agentbot_run_token "$@" ;;
	update | upgrade) agentbot_run_backend "$command" "$@" ;;
	help | -h | --help) agentbot_usage "$@" ;;
	*) agentbot_die "unknown command: $command (run agentbot help)" ;;
	esac
}

if [[ "${AGENTBOT_SOURCE_ONLY:-0}" != 1 ]]; then
	agentbot_main "$@"
fi
